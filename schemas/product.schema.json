{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/42kohd/docpack/main/schemas/1.0/product.schema.json",
  "title": "Product",
  "description": "product.yaml in a project; product.json (without nav) in a package.",
  "type": "object",
  "required": ["name", "short", "binary", "version", "support_email"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "short": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "binary": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "support_email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"},
    "nav": {"type": "array", "items": {"$ref": "#/$defs/group"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "group": {
      "oneOf": [
        {
          "type": "object",
          "required": ["group", "items"],
          "additionalProperties": false,
          "properties": {"group": {"type": "string", "minLength": 1}, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}}
        },
        {
          "type": "object",
          "required": ["group", "from"],
          "additionalProperties": false,
          "properties": {
            "group": {"type": "string", "minLength": 1},
            "from": {"type": "string", "pattern": "^(releases|dashboards/[a-z0-9]+(-[a-z0-9]+)*)$"},
            "limit": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "item": {
      "oneOf": [
        {"$ref": "#/$defs/slug"},
        {
          "type": "object",
          "required": ["doc"],
          "additionalProperties": false,
          "properties": {"doc": {"$ref": "#/$defs/slug"}, "children": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}}
        },
        {"$ref": "#/$defs/group"}
      ]
    }
  }
}
