{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/42kohd/docpack/main/schemas/1.0/data/releases.schema.json",
  "title": "Releases, newest first",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["version", "date", "kind", "items"],
    "additionalProperties": false,
    "properties": {
      "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "kind": {"enum": ["major", "minor", "patch"]},
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "type", "text"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "type": {"enum": ["feature", "fix", "change", "deprecation"]},
            "text": {"type": "string", "minLength": 1}
          }
        }
      },
      "advisories": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "text"],
          "additionalProperties": false,
          "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}
        }
      },
      "upgrade_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
    }
  }
}
