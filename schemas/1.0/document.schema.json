{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/42kohd/docpack/main/schemas/1.0/document.schema.json",
  "title": "Document",
  "description": "One compiled document: frontmatter as header fields plus a body of section blocks.",
  "type": "object",
  "required": ["type", "slug", "title", "summary", "body"],
  "additionalProperties": false,
  "properties": {
    "type": {"enum": ["landing", "concept", "howto", "integration", "format", "reference", "dashboard", "release"]},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "icon": {"type": "string", "pattern": "^assets/"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "target": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "dashboard_id": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "since": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
    "status": {"enum": ["ga", "prerelease"]},
    "nav_title": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "related": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "body": {
      "type": "array",
      "items": {"allOf": [{"$ref": "block.schema.json"}, {"properties": {"type": {"const": "section"}}}]}
    }
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "integration"}}}, "then": {"required": ["category", "icon"]}, "else": {"not": {"anyOf": [{"required": ["category"]}, {"required": ["icon"]}]}}},
    {"if": {"properties": {"type": {"const": "release"}}}, "then": {"required": ["version", "date"]}, "else": {"not": {"anyOf": [{"required": ["version"]}, {"required": ["date"]}]}}},
    {"if": {"properties": {"type": {"const": "dashboard"}}}, "then": {"required": ["target", "dashboard_id"]}, "else": {"not": {"anyOf": [{"required": ["target"]}, {"required": ["dashboard_id"]}]}}},
    {"if": {"properties": {"type": {"const": "howto"}}}, "then": {"required": ["task"]}, "else": {"not": {"required": ["task"]}}}
  ]
}
