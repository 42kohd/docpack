{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/42kohd/docpack/main/schemas/1.0/data/platforms.schema.json",
  "title": "Platforms",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["os", "version", "arch", "capabilities"],
    "additionalProperties": false,
    "properties": {
      "os": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
      "version": {"type": "string", "minLength": 1},
      "arch": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["amd64", "arm64"]}},
      "capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}}
    }
  }
}
